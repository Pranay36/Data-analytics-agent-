# Copy to /opt/insightflow/deploy/.env on the server and fill in. Never commit the real file.
# Generate secrets with:  openssl rand -hex 32     (passwords: openssl rand -hex 16)

# ── Where things are ─────────────────────────────────────────────────────────
# The hostname the API is served on. With no domain, use <your elastic IP with dashes>.sslip.io,
# e.g. IP 13.233.10.20 -> 13-233-10-20.sslip.io  (a free name that points back at that IP).
API_HOST=
# Your Vercel site, exactly as the browser shows it (used for CORS).
WEB_ORIGIN=https://your-app.vercel.app

# ── Database passwords (any URL-safe string; hex is safest) ──────────────────
APPDB_PASSWORD=
DEMO_PASSWORD=

# ── Application secrets ──────────────────────────────────────────────────────
AUTH_SECRET_KEY=
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATASOURCE_ENCRYPTION_KEY=

# ── Model providers (the free tiers) ─────────────────────────────────────────
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# ── Public-demo behaviour ────────────────────────────────────────────────────
# true: nobody can point the server at their own database.
DEMO_MODE=true
# false closes sign-ups, if free-tier quota is being used up.
AUTH_ALLOW_REGISTRATION=true
QUOTA_ANALYSES_PER_DAY=10
QUOTA_LLM_CALLS_PER_DAY=80
QUOTA_TOKENS_PER_DAY=500000
# Optional first administrator.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
