# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=local
DEMO_MODE=false
CORS_ORIGINS=http://localhost:3000

# ── Databases ────────────────────────────────────────────────────────────────
# System plane: InsightFlow's own metadata + pgvector (docker compose: appdb).
DATABASE_URL=postgresql+asyncpg://insightflow:insightflow@localhost:5432/insightflow
# Analytical plane: the seeded "customer" warehouse (docker compose: demo-analytics).
# Note the driver differs: connectors use sync psycopg, the app DB uses asyncpg.
DEMO_ANALYTICS_URL=postgresql://shopsphere:shopsphere@localhost:5433/shopsphere

# ── Secrets ──────────────────────────────────────────────────────────────────
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATASOURCE_ENCRYPTION_KEY=

# ── LLM providers (ordered fallback chain; see PROJECT_PLAN §17.6) ───────────
# Each provider has its own independent free quota, so chaining them multiplies
# the daily budget. Format: provider:model,provider:model
# Verify current free model ids before use — they change often.
LLM_FALLBACK_CHAIN=

GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Per-agent overrides. Empty = use the head of the fallback chain.
# Give the Query Agent the strongest model; Visualization can use the smallest.
LLM_MODEL_QUERY=
LLM_MODEL_ANALYSIS=
LLM_MODEL_VISUALIZATION=

LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_CONCURRENCY=2

# ── Quota protection ─────────────────────────────────────────────────────────
# Caches responses on disk by (model, messages, schema) so that iterating on
# code downstream of the LLM costs nothing.
LLM_CACHE_ENABLED=true
LLM_CACHE_MODE=read_write

# ── SQL safety ───────────────────────────────────────────────────────────────
SQL_MAX_ROWS=500
SQL_TIMEOUT_SECONDS=20

# ── Agent budgets ────────────────────────────────────────────────────────────
MAX_DRILLDOWN_DEPTH=3
MAX_LLM_CALLS_PER_ANALYSIS=12
MAX_TOKENS_PER_ANALYSIS=80000
MAX_SQL_REPAIR_ATTEMPTS=2
# Set false while developing to cut ~1/3 of LLM calls per analysis.
VIZ_AGENT_ENABLED=true
