# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=local
DEMO_MODE=false
CORS_ORIGINS=http://localhost:3000

# ── Databases ────────────────────────────────────────────────────────────────
# System plane: InsightFlow's own metadata + pgvector (docker compose: appdb).
DATABASE_URL=postgresql+asyncpg://insightflow:insightflow@localhost:5432/insightflow
# Analytical plane: the seeded "customer" warehouse (docker compose: demo-analytics).
# Note the driver differs: connectors use sync psycopg, the app DB uses asyncpg.
DEMO_ANALYTICS_URL=postgresql://shopsphere:shopsphere@localhost:5433/shopsphere

# ── Secrets ──────────────────────────────────────────────────────────────────
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATASOURCE_ENCRYPTION_KEY=

# ── Models ───────────────────────────────────────────────────────────────────
# Defaults live in backend/models.yaml. Set these only to override it.
# LLM_FALLBACK_CHAIN=groq:openai/gpt-oss-120b,openrouter:qwen/qwen3.8-27b:free
# EMBEDDING_MODEL=openrouter:liquid/lfm-2.5-embedding-350m:free
# LLM_MODEL_QUERY=            # per-agent override; the strongest model belongs here
# LLM_MODEL_ANALYSIS=
# LLM_MODEL_VISUALIZATION=

# ── Provider credentials ─────────────────────────────────────────────────────
# Groq carries the LLM load (1,000 requests/day); OpenRouter's 50/day is
# reserved for embeddings. Gemini is optional and only needed if selected.
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_CONCURRENCY=2

# ── Quota protection ─────────────────────────────────────────────────────────
# Caches responses on disk by (model, messages, schema) so that iterating on
# code downstream of the LLM costs nothing.
LLM_CACHE_ENABLED=true
LLM_CACHE_MODE=read_write

# ── SQL safety ───────────────────────────────────────────────────────────────
SQL_MAX_ROWS=500
SQL_TIMEOUT_SECONDS=20

# ── Agent budgets ────────────────────────────────────────────────────────────
MAX_DRILLDOWN_DEPTH=3
MAX_LLM_CALLS_PER_ANALYSIS=12
MAX_TOKENS_PER_ANALYSIS=80000
MAX_SQL_REPAIR_ATTEMPTS=2
# Set false while developing to cut ~1/3 of LLM calls per analysis.
VIZ_AGENT_ENABLED=true

# ── Authentication ───────────────────────────────────────────────────────────
# Signs login tokens. Required: the app refuses to start without a strong one.
#   openssl rand -hex 32
AUTH_SECRET_KEY=
AUTH_ACCESS_TOKEN_MINUTES=30
AUTH_REFRESH_TOKEN_DAYS=14
# Set false to close sign-ups (a public demo with free-tier LLM quota).
AUTH_ALLOW_REGISTRATION=true
# Deployed over HTTPS: true. Frontend on a different domain: samesite=none (needs secure=true).
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
# Per-account daily ceilings, on top of the per-analysis budget above.
QUOTA_ANALYSES_PER_DAY=20
QUOTA_LLM_CALLS_PER_DAY=150
QUOTA_TOKENS_PER_DAY=1000000
# Optional: create this administrator on startup.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
